        <!-- Optional: Override default retry settings -->
        <!-- <add key="StoryLogStoreRetryCount" value="3" /> -->
        <!-- <add key="StoryLogStoreRetryTimeoutMs" value="500" /> -->
        
        <!-- Optional: Override client version -->
        <!-- <add key="StoryLogStoreClientVersion" value="1.0.0" /> -->
        
        <!-- Optional: Override ruleset version -->
        <!-- <add key="StoryLogStoreRulesetVersion" value="1" /> -->
